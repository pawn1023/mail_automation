# Prefer accounts.json for multiple Gmail + app-password pairs.
# GitHub token is optional — bot runs unauthenticated (60 req/hour, slower pacing).
# GITHUB_TOKEN=ghp_xxxxxxxx

# Daily mail cap (total across all accounts, per region timezone day)
# DAILY_SEND_LIMIT=30
# DAILY_SEND_LIMIT_USA=30
# DAILY_SEND_LIMIT_EUROPE=20
